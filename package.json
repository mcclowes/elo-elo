{
  "name": "elo-elo",
  "version": "0.0.8",
  "description": "Elo rating functionality",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "dist": "dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcclowes/elo-elo.git"
  },
  "keywords": [
    "elo"
  ],
  "files": [
    "dist"
  ],
  "author": "Max Clayton Clowes <contact@mcclowes.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mcclowes/elo-elo/issues"
  },
  "homepage": "https://github.com/mcclowes/elo-elo#readme",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write src/",
    "format:staged": "pretty-quick --staged --pattern ./src/**",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format:staged && npm run build"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
